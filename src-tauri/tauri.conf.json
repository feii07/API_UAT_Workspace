{
  "productName": "API UAT Workspace",
  "version": "0.1.0",
  "identifier": "com.local.apiuatworkspace",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --port 1420",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "API UAT Workspace",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"]
  }
}
}
